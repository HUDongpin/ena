# Open ENA access control (server only; password >= 12 chars, session secret >= 32 chars)
OPEN_ENA_USERNAME=
OPEN_ENA_PASSWORD=
OPEN_ENA_SESSION_SECRET=
# Stable opaque deployment/account identifier; do not rotate it on login or session-secret rotation.
OPEN_ENA_ACCOUNT_ID=
# Operator-owned browser origins. Required in production; comma-separated values
# are allowed for an explicitly controlled secondary origin. Do not derive this
# from Host, X-Forwarded-Host, or any other client-supplied header.
OPEN_ENA_PUBLIC_ORIGIN=https://www.ena.hk
OPEN_ENA_ALLOWED_ORIGINS=https://www.ena.hk,https://ena.hk
# PostgreSQL URL for shared login-attempt windows and per-session revocation.
OPEN_ENA_AUTH_DATABASE_URL=
# Optional edge-rewritten client-IP header for the tighter source bucket. Leave
# blank unless the trusted proxy strips the client-supplied version first.
OPEN_ENA_TRUSTED_CLIENT_IP_HEADER=
# Versioned SEC-01 billable policy (server-only; missing/invalid values fail closed)
OPEN_ENA_BILLING_POLICY_VERSION=v1
OPEN_ENA_BILLABLE_REQUESTS_PER_MINUTE=6
OPEN_ENA_AI_DAILY_MICRO_USD=100000
OPEN_ENA_AI_MONTHLY_MICRO_USD=500000
OPEN_ENA_GLOBAL_MONTHLY_MICRO_USD=2000000
OPEN_ENA_PROVIDER_MONTHLY_MICRO_USD=2000000
OPEN_ENA_AI_MAX_RESERVATION_MICRO_USD=10000
OPEN_ENA_LONGITUDINAL_MAX_RESERVATION_MICRO_USD=20000
OPEN_ENA_BILLABLE_MAX_CONCURRENCY=2
OPEN_ENA_SECURITY_ALERT_THRESHOLDS=50,80,100
OPEN_ENA_BILLABLE_DATABASE_URL=

# Optional persistent longitudinal compute control plane (server-side submit proxy).
# Use HTTPS in deployed environments; loopback HTTP is accepted only for local QA.
OPEN_ENA_LONGITUDINAL_COMPUTE_URL=
# Plaintext server-to-server credential (32-512 non-whitespace characters).
# The compute runtime receives only this value's SHA-256 digest.
OPEN_ENA_LONGITUDINAL_COMPUTE_TOKEN=

# Optional AI-assisted interpretation through OpenRouter (server only)
OPEN_ENA_AI_ENABLED=false
OPENROUTER_API_KEY=
# HTTPS OpenRouter host is enforced by the server client.
OPEN_ENA_AI_BASE_URL=https://openrouter.ai/api/v1
OPEN_ENA_AI_MODEL=openai/gpt-5.6-luna
