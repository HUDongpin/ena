# Open ENA access control (server only; password >= 12 chars, session secret >= 32 chars)
OPEN_ENA_USERNAME=
OPEN_ENA_PASSWORD=
OPEN_ENA_SESSION_SECRET=

# Optional AI-assisted interpretation through OpenRouter (server only)
OPEN_ENA_AI_ENABLED=false
OPENROUTER_API_KEY=
# HTTPS OpenRouter host is enforced by the server client.
OPEN_ENA_AI_BASE_URL=https://openrouter.ai/api/v1
OPEN_ENA_AI_MODEL=openai/gpt-5.6-luna
